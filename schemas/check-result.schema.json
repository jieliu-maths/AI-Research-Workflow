{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.research-workflow/check-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "plan",
    "candidate",
    "kind",
    "scope",
    "outcome",
    "execution",
    "evaluation",
    "stdout",
    "stderr",
    "inputs_unchanged",
    "protected_files_unchanged"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "const": "evidence_only"
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "kind": {
      "enum": [
        "symbolic",
        "scale",
        "finite_check",
        "numerical",
        "formal_certificate"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": [
        "passed",
        "failed",
        "inconclusive"
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "exit_code",
        "elapsed_seconds",
        "timed_out",
        "runner_version"
      ],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exit_code": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        },
        "timed_out": {
          "type": "boolean"
        },
        "runner_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evaluation": {
      "type": "object"
    },
    "stdout": {
      "type": "string"
    },
    "stderr": {
      "type": "string"
    },
    "inputs_unchanged": {
      "type": "boolean"
    },
    "protected_files_unchanged": {
      "type": "boolean"
    }
  }
}
