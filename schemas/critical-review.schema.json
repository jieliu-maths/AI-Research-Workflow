{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.research-workflow/critical-review.schema.json",
  "title": "On-demand mathematical review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "review_kind",
    "reviewer",
    "question",
    "baseline",
    "candidate",
    "assessment",
    "baseline_frozen_before_candidate",
    "derivation_roots",
    "overlapping_roots",
    "verdict"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^R[0-9]+$"
    },
    "review_kind": {
      "enum": [
        "self_check",
        "independent"
      ]
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "baseline_frozen_before_candidate": {
      "type": "boolean"
    },
    "derivation_roots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "overlapping_roots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "verdict": {
      "enum": [
        "reject",
        "uncertain",
        "survives_current_attacks"
      ]
    },
    "claim_id": {
      "type": "string",
      "pattern": "^P[0-9]+$"
    },
    "revision": {
      "type": "string",
      "pattern": "^v[1-9][0-9]*$"
    },
    "claim_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.1"
          }
        }
      },
      "then": {
        "required": [
          "claim_id",
          "revision",
          "claim_record"
        ]
      }
    }
  ]
}
