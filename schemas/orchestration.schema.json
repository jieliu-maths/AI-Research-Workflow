{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.research-workflow/orchestration.schema.json",
  "title": "Director orchestration state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "route_id", "director_state", "active_task_id", "awaiting_role", "last_completed_task_id", "next_action", "owner_gate", "processed_return_keys", "updated_at"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "pattern": "^R[0-9]+$" },
    "route_id": { "oneOf": [{ "type": "string", "pattern": "^route:[A-Za-z0-9][A-Za-z0-9._-]*$" }, { "type": "null" }] },
    "director_state": { "enum": ["idle", "dispatching", "waiting_researcher", "director_review_researcher", "waiting_critic", "director_review_critic", "adjudicating", "advancing", "owner_gate", "run_closure", "closed"] },
    "active_task_id": { "oneOf": [{ "type": "string", "pattern": "^T[0-9]+$" }, { "type": "null" }] },
    "awaiting_role": { "enum": ["researcher", "critic", "experimenter", null] },
    "last_completed_task_id": { "oneOf": [{ "type": "string", "pattern": "^T[0-9]+$" }, { "type": "null" }] },
    "next_action": { "type": ["string", "null"] },
    "owner_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "reason", "approval_reference"],
      "properties": {
        "required": { "type": "boolean" },
        "reason": { "type": ["string", "null"] },
        "approval_reference": { "type": ["string", "null"] }
      }
    },
    "processed_return_keys": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "updated_at": { "type": ["string", "null"] }
  }
}
